<?xml version="1.0" encoding="utf-8"?>
<!-- TextureView-backed player: it composes like a normal view, so the danmaku layer drawn
     above it in Compose is always visible (a SurfaceView can end up covering it). -->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:shutter_background_color="@android:color/black" />
